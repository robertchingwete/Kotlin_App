<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    tools:context=".CalendarFragment">

    <!-- TabLayout for daily, weekly, and monthly tabs -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="@color/primary_color"
        android:elevation="6dp"
        android:padding="8dp"
        app:tabIndicatorColor="@color/accent_color"
        app:tabIndicatorHeight="4dp"
        app:tabSelectedTextColor="@color/white"
        app:tabTextColor="@color/tab_unselected" />

    <!-- Calendar View inside a Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_calendar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tab_layout"
        android:layout_margin="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="6dp">

        <CalendarView
            android:id="@+id/calendar_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:dateTextAppearance="?android:attr/textAppearanceMedium"
            android:weekDayTextAppearance="?android:attr/textAppearanceSmall"
            android:focusedMonthDateColor="@color/primary_color"
            android:unfocusedMonthDateColor="@color/text_secondary"
            android:weekSeparatorLineColor="@color/separator_line"
            android:background="@color/card_background" />
    </androidx.cardview.widget.CardView>

    <!-- RecyclerView to display events -->
    <androidx.cardview.widget.CardView
        android:id="@+id/event_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/card_calendar"
        android:layout_margin="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/event_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/card_background"
            android:padding="8dp"
            android:scrollbars="vertical" />
    </androidx.cardview.widget.CardView>

    <!-- Floating Action Button to add events -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_add_event"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_margin="16dp"
        android:contentDescription="Add Event"
        android:src="@drawable/ic_add"
        android:backgroundTint="@color/accent_color"
        app:fabSize="normal" />

</RelativeLayout>
