<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background color for the display -->
    <solid android:color="#263238"/>

    <!-- Rounded corners for the display -->
    <corners android:radius="16dp"/>

    <!-- Optional: Add a subtle shadow or border to make the display stand out -->
    <stroke android:color="#000000" android:width="1dp"/>

    <!-- Optional: Add a gradient effect for a more modern look -->
    <gradient
        android:startColor="#263238"
        android:centerColor="#455A64"
        android:endColor="#607D8B"
        android:angle="90"/>
</shape>
